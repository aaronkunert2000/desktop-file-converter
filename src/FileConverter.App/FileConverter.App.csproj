<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- nur für NotifyIcon (Tray) -->
    <Nullable>enable</Nullable>
    <!-- Bewusst aus: WPF + WinForms-Implicit-Usings erzeugen sonst mehrdeutige Typen (Application, Point, ...) -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FileConverter</AssemblyName>
    <RootNamespace>FileConverter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <!-- WinForms-Analyzer meldet DPI-Einstellungen im Manifest; für WPF ist das Manifest der richtige Ort -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bildkonvertierung (Apache-2.0). Floating 14.*, bis wir eine Version festnageln. -->
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.*" />
    <!-- Dokumente: Markdown (BSD), DOCX lesen/schreiben (MIT), HTML -> Markdown (MIT), PDF über WebView2 -->
    <PackageReference Include="Markdig" Version="0.*" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
    <PackageReference Include="ReverseMarkdown" Version="4.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
  </ItemGroup>

</Project>
